rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{shopId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /groups/{groupId} {
      allow read, write: if false;
      match /sessions/{sessionId} {
        allow read, write: if false;
      }
    }
  }
}

