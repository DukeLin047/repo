rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inventory/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /apiKeys/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'love90560@gmail.com';
    }
    match /dealerStock/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /consignment/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /priceList/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /allowedGroups/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /pendingGroups/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
